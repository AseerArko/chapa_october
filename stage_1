def load_metadata():
    dfs = []
    for p in PART_NUMBERS:
        csv = os.path.join(ROOT_TMPL.format(p), "metadata.csv")
        if not os.path.isfile(csv):
            print(f"[MISSING] {csv}"); continue
        df = pd.read_csv(csv)
        df["_root"] = ROOT_TMPL.format(p)
        dfs.append(df)
    if not dfs:
        raise RuntimeError("No metadata found.")
    df = pd.concat(dfs, ignore_index=True)
    df = df[df["wave_type"] == WAVE_TYPE].reset_index(drop=True)
    print(f"Sequences after wave_type='{WAVE_TYPE}': {len(df)}")
    for col in ["sequence_id", "source_filename", "image_sequence", "warp", "gt"]:
        if col not in df.columns:
            raise RuntimeError(f"Missing column: {col}")
    return df


def split_df(df):
    srcs = df["source_filename"].unique().tolist()
    random.Random(SEED).shuffle(srcs)
    n = max(1, int(len(srcs) * TEST_SPLIT))
    test_srcs  = set(srcs[:n])
    train_srcs = set(srcs[n:])
    train = df[df["source_filename"].isin(train_srcs)].reset_index(drop=True)
    test  = df[df["source_filename"].isin(test_srcs)].reset_index(drop=True)
    print(f"Train: {len(train)} seqs  |  Test: {len(test)} seqs")
    return train, test

# ==============================================================================
# 2.  WARP STATISTICS  (one-time, cached to disk, vectorised)
# ==============================================================================
def compute_warp_stats(train_df):
    if os.path.isfile(WARP_STATS_PATH):
        with open(WARP_STATS_PATH) as f:
            s = json.load(f)
        print(f"[warp_stats] Loaded  wx_mean={s['wx_mean']:.3f} "
              f"wx_std={s['wx_std']:.3f}  wy_mean={s['wy_mean']:.3f} "
              f"wy_std={s['wy_std']:.3f}")
        return s

    print("[warp_stats] Computing (vectorised scan)...")
    wx_sum = wx_sq = wy_sum = wy_sq = 0.0
    n_wx = n_wy = 0

    for i, (_, row) in enumerate(train_df.iterrows()):
        z  = np.load(os.path.join(row["_root"], row["warp"]))
        wx = z["warp_x"].astype(np.float64)   # full array, no loop
        wy = z["warp_y"].astype(np.float64)

        wx_sum += wx.sum();  wx_sq += (wx ** 2).sum();  n_wx += wx.size
        wy_sum += wy.sum();  wy_sq += (wy ** 2).sum();  n_wy += wy.size

        if i % 50 == 0:
            print(f"  [{i}/{len(train_df)}]", end="\r")

    wx_mean = wx_sum / n_wx
    wy_mean = wy_sum / n_wy
    wx_std  = max(float(np.sqrt(wx_sq / n_wx - wx_mean ** 2)), 1e-6)
    wy_std  = max(float(np.sqrt(wy_sq / n_wy - wy_mean ** 2)), 1e-6)

    s = {"wx_mean": float(wx_mean), "wx_std": wx_std,
         "wy_mean": float(wy_mean), "wy_std": wy_std}
    with open(WARP_STATS_PATH, "w") as f:
        json.dump(s, f, indent=2)
    print(f"\n[warp_stats] Done  wx_mean={wx_mean:.3f} wx_std={wx_std:.3f}  "
          f"wy_mean={wy_mean:.3f} wy_std={wy_std:.3f}")
    return s

# ==============================================================================
# 2b. MEAN-FRAME REFERENCE  (one-time, cached to disk)
#     Mean over ALL frames of a sequence -> blurry, ripple-free reference.
# ==============================================================================
def _load_img_np(path):
    img = Image.open(path).convert("RGB").resize((IMG_SIZE, IMG_SIZE),
                                                  Image.BICUBIC)
    return np.asarray(img, np.float32) / 127.5 - 1.0     # (H,W,3) in [-1,1]


def ref_cache_path(row):
    key = f"{os.path.basename(row['_root'])}_{row['sequence_id']}"
    return os.path.join(REF_DIR, f"{key}.npy")


def build_ref_cache(df):
    """Compute and cache the temporal-mean frame for every sequence in df."""
    todo = [r for _, r in df.iterrows() if not os.path.isfile(ref_cache_path(r))]
    print(f"[ref] {len(df) - len(todo)} cached, {len(todo)} to compute.")
    t0 = time.perf_counter()
    for i, row in enumerate(todo, 1):
        seq_dir = os.path.join(row["_root"], row["image_sequence"])
        paths = sorted(glob.glob(os.path.join(seq_dir, "*.png")))
        if len(paths) == 0:
            raise RuntimeError(f"No frames in {seq_dir}")
        acc = np.zeros((IMG_SIZE, IMG_SIZE, 3), np.float64)
        for p in paths:
            acc += _load_img_np(p)
        mean = (acc / len(paths)).astype(np.float32).transpose(2, 0, 1)  # (3,H,W)
        tmp = ref_cache_path(row) + ".tmp.npy"
        np.save(tmp, mean.astype(np.float16))
        os.replace(tmp, ref_cache_path(row))
        if i % 25 == 0 or i == len(todo):
            print(f"[ref] {i}/{len(todo)}  ({time.perf_counter()-t0:.0f}s)")

# ==============================================================================
# 3.  DATASET
#     Returns 3 consecutive distorted frames, the mean-frame reference,
#     GT warp (middle frame), GT clean image.
# ==============================================================================
class WaveDataset(Dataset):
    def __init__(self, df, warp_stats):
        self.df = df.reset_index(drop=True)
        self.ws = warp_stats

    def __len__(self):
        return len(self.df)

    @staticmethod
    def _load_img(path):
        x = _load_img_np(path)
        return torch.from_numpy(x.transpose(2, 0, 1))   # (3,H,W) in [-1,1]

    @staticmethod
    def _resize_warp(arr2d):
        """(H_orig, W_orig) -> (1, IMG_SIZE, IMG_SIZE) tensor"""
        t = torch.from_numpy(arr2d.astype(np.float32)).unsqueeze(0).unsqueeze(0)
        t = F.interpolate(t, (IMG_SIZE, IMG_SIZE), mode="bilinear",
                          align_corners=True)
        return t.squeeze(0)   # (1, H, W)

    def __getitem__(self, idx):
        row  = self.df.iloc[idx]
        root = row["_root"]

        # ---- distorted frame triplet ----
        seq_dir = os.path.join(root, row["image_sequence"])
        paths   = sorted(glob.glob(os.path.join(seq_dir, "*.png")))
        if len(paths) < 3:
            raise RuntimeError(f"Need ≥3 frames, got {len(paths)}: {seq_dir}")

        lo  = random.randint(0, len(paths) - 3)
        tri = [paths[lo], paths[lo+1], paths[lo+2]]
        frames = torch.stack([self._load_img(p) for p in tri], dim=0)  # (3,3,H,W)

        # ---- mean-frame reference (cached) ----
        ref = torch.from_numpy(
            np.load(ref_cache_path(row)).astype(np.float32))           # (3,H,W)

        # ---- GT warp for the middle frame (frame index lo+1) ----
        z    = np.load(os.path.join(root, row["warp"]))
        wx_r = z["warp_x"]   # (H_orig, W_orig, T_orig)
        wy_r = z["warp_y"]
        fi   = min(lo + 1, wx_r.shape[2] - 1)
        wx   = self._resize_warp(wx_r[:, :, fi])
        wy   = self._resize_warp(wy_r[:, :, fi])

        ws = self.ws
        wx_n = (wx - ws["wx_mean"]) / ws["wx_std"]
        wy_n = (wy - ws["wy_mean"]) / ws["wy_std"]

        # ---- GT clean image ----
        gt = self._load_img(os.path.join(root, row["gt"]))

        return frames, ref, wx_n, wy_n, gt, row["sequence_id"]

# ==============================================================================
# 4.  DIS-NET ARCHITECTURE
#     Only change vs. working base: each branch takes [frame | ref] = 6 ch.
# ==============================================================================
class EncoderBlock(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, 3, padding=1), nn.BatchNorm2d(out_ch),
            nn.LeakyReLU(0.2, True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1), nn.BatchNorm2d(out_ch),
            nn.LeakyReLU(0.2, True),
        )
        self.pool = nn.MaxPool2d(2)

    def forward(self, x):
        feat = self.conv(x)
        return self.pool(feat), feat   # (pooled, skip)


class DecoderBlock(nn.Module):
    """Variational refinement: up + skip + intermediate warp -> refined warp."""
    def __init__(self, in_ch, skip_ch, out_ch):
        super().__init__()
        self.up   = nn.ConvTranspose2d(in_ch, out_ch, 4, stride=2, padding=1)
        self.warp_proj = nn.Conv2d(2, out_ch, 1)   # intermediate warp map -> feat
        self.conv = nn.Sequential(
            nn.Conv2d(out_ch + skip_ch + out_ch, out_ch, 3, padding=1),
            nn.BatchNorm2d(out_ch), nn.LeakyReLU(0.2, True),
        )
        self.warp_head = nn.Conv2d(out_ch, 2, 1)   # intermediate warp output

    def forward(self, x, skip, prev_warp_up):
        up   = self.up(x)
        pw   = F.interpolate(prev_warp_up, size=up.shape[-2:],
                             mode="bilinear", align_corners=True)
        pw_f = self.warp_proj(pw)
        cat  = torch.cat([up, skip, pw_f], dim=1)
        feat = self.conv(cat)
        warp = self.warp_head(feat)
        return feat, warp


class SingleFrameCNN(nn.Module):
    """Predicts a (2,H,W) warp map from [distorted frame | reference] (6 ch)."""
    def __init__(self, in_ch=6):
        super().__init__()
        # Encoder: 256->128->64->32->16
        self.e1 = EncoderBlock(in_ch, 32)
        self.e2 = EncoderBlock(32,  64)
        self.e3 = EncoderBlock(64, 128)
        self.e4 = EncoderBlock(128,256)

        # Bottleneck
        self.bottleneck = nn.Sequential(
            nn.Conv2d(256, 256, 3, padding=1), nn.BatchNorm2d(256),
            nn.LeakyReLU(0.2, True),
        )
        self.warp_bottleneck = nn.Conv2d(256, 2, 1)

        # Decoder: skip_ch must match encoder output at each level
        #   s4=256ch  s3=128ch  s2=64ch  s1=32ch
        self.d4 = DecoderBlock(256, 256, 128)   # up(128)+skip(256)+warp_proj(128) = 512
        self.d3 = DecoderBlock(128, 128,  64)   # up(64) +skip(128)+warp_proj(64)  = 256
        self.d2 = DecoderBlock( 64,  64,  32)   # up(32) +skip(64) +warp_proj(32)  = 128
        self.d1 = DecoderBlock( 32,  32,  16)   # up(16) +skip(32) +warp_proj(16)  = 64

        # Final warp output
        self.final = nn.Conv2d(16, 2, 1)

    def forward(self, x):
        # x: (B,6,H,W)
        p1, s1 = self.e1(x)
        p2, s2 = self.e2(p1)
        p3, s3 = self.e3(p2)
        p4, s4 = self.e4(p3)

        b  = self.bottleneck(p4)
        w  = self.warp_bottleneck(b)          # (B,2,H/16,W/16)

        f4, w4 = self.d4(b,  s4, w)
        f3, w3 = self.d3(f4, s3, w4)
        f2, w2 = self.d2(f3, s2, w3)
        f1, w1 = self.d1(f2, s1, w2)

        warp_final = self.final(f1) + F.interpolate(
            w1, size=f1.shape[-2:], mode="bilinear", align_corners=True)

        return warp_final, [w, w4, w3, w2]    # final + multi-scale intermediates


class ConvLSTMCell(nn.Module):
    def __init__(self, in_ch, hidden_ch, ks=3):
        super().__init__()
        self.h = hidden_ch
        self.gates = nn.Conv2d(in_ch + hidden_ch, 4 * hidden_ch, ks,
                               padding=ks // 2)

    def forward(self, x, state):
        h, c = state
        i, f, o, g = torch.chunk(self.gates(torch.cat([x, h], 1)), 4, 1)
        c = torch.sigmoid(f) * c + torch.sigmoid(i) * torch.tanh(g)
        h = torch.sigmoid(o) * torch.tanh(c)
        return h, c

    def init(self, B, H, W, device, dtype):
        z = torch.zeros(B, self.h, H, W, device=device, dtype=dtype)
        return z.clone(), z.clone()


class DisNet(nn.Module):
    """
    Input:  frames (B,3,3,H,W) distorted frames,  ref (B,3,H,W) mean frame
    Output: warp   (B,2,H,W)   normalised warp field for middle frame
    """
    def __init__(self, lstm_hidden=64):
        super().__init__()
        self.branch = SingleFrameCNN(in_ch=6)   # shared weights across frames
        self.lstm1 = ConvLSTMCell(2, lstm_hidden)
        self.lstm2 = ConvLSTMCell(lstm_hidden, lstm_hidden)
        self.refine = nn.Sequential(
            nn.Conv2d(lstm_hidden, 32, 3, padding=1), nn.LeakyReLU(0.2, True),
            nn.Conv2d(32, 2, 1),
        )

    def forward(self, frames, ref):
        B, T, C, H, W = frames.shape
        h1, c1 = self.lstm1.init(B, H, W, frames.device, frames.dtype)
        h2, c2 = self.lstm2.init(B, H, W, frames.device, frames.dtype)

        all_warps = []
        all_inter = []

        for t in range(T):
            x_t = torch.cat([frames[:, t], ref], dim=1)     # (B,6,H,W)
            warp_t, inter_t = self.branch(x_t)
            h1, c1 = self.lstm1(warp_t, (h1, c1))
            h2, c2 = self.lstm2(h1,     (h2, c2))
            refined = self.refine(h2) + warp_t              # residual
            all_warps.append(refined)
            all_inter.append(inter_t)

        # Primary output: middle frame (index 1)
        return all_warps[1], all_warps, all_inter[1]

# ==============================================================================
# 5.  PHYSICS LOSSES   (unchanged from working base)
# ==============================================================================
def scale_invariant_error(pred, target):
    diff = pred - target
    M    = diff.shape[-1] * diff.shape[-2]
    mse  = (diff ** 2).mean(dim=(-1, -2))
    bias = (diff.mean(dim=(-1, -2))) ** 2
    return (mse - 0.5 * bias).mean()


def gradient_matching_error(pred, target):
    """
    L1 between first-order finite differences (x and y) of two warp fields.
    Penalises over-smoothing directly: a blurred prediction has small pixel
    error but clearly wrong local gradients.
    """
    dpx = pred[..., :, 1:] - pred[..., :, :-1]
    dtx = target[..., :, 1:] - target[..., :, :-1]
    dpy = pred[..., 1:, :] - pred[..., :-1, :]
    dty = target[..., 1:, :] - target[..., :-1, :]
    return F.l1_loss(dpx, dtx) + F.l1_loss(dpy, dty)


def loss_warp(pred_w, gt_w, inter_maps, gt_w_scales, warp_stats, pred_raw=None):
    """
    pred_w   : clamped prediction (used for the reconstruction terms)
    pred_raw : UNclamped prediction (used for the magnitude penalty so it still
               has gradient outside the clamp range)
    """
    L_W = scale_invariant_error(pred_w, gt_w)

    # Multi-scale intermediate warp losses
    L_ms = 0.0
    for inter, gt_s in zip(inter_maps, gt_w_scales):
        L_ms = L_ms + scale_invariant_error(inter, gt_s)

    if pred_raw is None:
        pred_raw = pred_w
    mag_penalty = F.relu(pred_raw.abs() - 4.0).mean()
    return L_W + 0.1 * L_ms + 0.5 * mag_penalty


def loss_refraction(frames, pred_w, warp_stats):
    I_mid = frames[:, 1]          # (B,3,H,W)  middle distorted frame

    ws   = warp_stats
    wx_px = pred_w[:, 0:1] * ws["wx_std"] + ws["wx_mean"]   # (B,1,H,W)
    wy_px = pred_w[:, 1:2] * ws["wy_std"] + ws["wy_mean"]

    B, C, H, W = I_mid.shape
    yy, xx = torch.meshgrid(
        torch.linspace(-1, 1, H, device=I_mid.device),
        torch.linspace(-1, 1, W, device=I_mid.device),
        indexing="ij",
    )
    base = torch.stack([xx, yy], -1).unsqueeze(0)   # (1,H,W,2)

    dx = 2.0 * wx_px.squeeze(1) / (W - 1)
    dy = 2.0 * wy_px.squeeze(1) / (H - 1)

    grid_bwd = torch.stack([base[..., 0] - dx,
                             base[..., 1] - dy], -1)   # (B,H,W,2)
    I_bwd = F.grid_sample(I_mid, grid_bwd, mode="bilinear",
                           padding_mode="border", align_corners=True)

    grid_fwd = torch.stack([base[..., 0] + dx,
                             base[..., 1] + dy], -1)
    I_recon = F.grid_sample(I_bwd, grid_fwd, mode="bilinear",
                             padding_mode="border", align_corners=True)

    return F.mse_loss(I_recon, I_mid)


def loss_temporal(frames, all_warps, warp_stats):
    ws = warp_stats
    undistorted = []
    B, _, H, W = frames[:, 0].shape

    yy, xx = torch.meshgrid(
        torch.linspace(-1, 1, H, device=frames.device),
        torch.linspace(-1, 1, W, device=frames.device),
        indexing="ij",
    )
    base = torch.stack([xx, yy], -1).unsqueeze(0)

    for t, w in enumerate(all_warps):
        I_t  = frames[:, t]
        wx_px = w[:, 0] * ws["wx_std"] + ws["wx_mean"]
        wy_px = w[:, 1] * ws["wy_std"] + ws["wy_mean"]
        dx = 2.0 * wx_px / (W - 1)
        dy = 2.0 * wy_px / (H - 1)
        grid = torch.stack([base[..., 0] - dx,
                            base[..., 1] - dy], -1)
        J_t = F.grid_sample(I_t, grid, mode="bilinear",
                             padding_mode="border", align_corners=True)
        undistorted.append(J_t)

    L_C = 0.0
    pairs = [(0,1), (1,2), (0,2)]
    for i, j in pairs:
        L_C = L_C + F.mse_loss(undistorted[i], undistorted[j])
    return L_C / len(pairs)

