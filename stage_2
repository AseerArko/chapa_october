# 3.  DATASET
#     Returns 3 distorted frames, the mean-frame reference (both for Dis-Net)
#     and the GT clean image.  Warp fields are predicted at runtime.
# ==============================================================================
class WaveDataset(Dataset):
    def __init__(self, df):
        self.df = df.reset_index(drop=True)
        self._paths = {}      # per-worker cache of sorted frame lists

    def __len__(self):
        return len(self.df)

    @staticmethod
    def _img(path):
        img = Image.open(path).convert("RGB").resize((IMG_SIZE, IMG_SIZE),
                                                      Image.BICUBIC)
        x = np.asarray(img, np.float32) / 127.5 - 1.0
        return torch.from_numpy(x.transpose(2, 0, 1))

    def __getitem__(self, idx):
        row  = self.df.iloc[idx]
        root = row["_root"]
        paths = self._paths.get(idx)
        if paths is None:
            paths = sorted(glob.glob(
                        os.path.join(root, row["image_sequence"], "*.png")))
            self._paths[idx] = paths
        if len(paths) < 3:
            raise RuntimeError(f"Need ≥3 frames: {row['image_sequence']}")
        lo     = random.randint(0, len(paths) - 3)
        frames = torch.stack([self._img(paths[lo+t]) for t in range(3)], 0)
        ref    = torch.from_numpy(
                    np.load(ref_cache_path(row)).astype(np.float32))   # (3,H,W)
        gt     = self._img(os.path.join(root, row["gt"]))
        return frames, ref, gt, row["sequence_id"]

