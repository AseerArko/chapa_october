def load_metadata():
    dfs = []
    for p in PART_NUMBERS:
        csv = os.path.join(ROOT_TMPL.format(p), "metadata.csv")
        if not os.path.isfile(csv): continue
        df = pd.read_csv(csv)
        df["_root"] = ROOT_TMPL.format(p)
        dfs.append(df)
    df = pd.concat(dfs, ignore_index=True)
    df = df[df["wave_type"] == WAVE_TYPE].reset_index(drop=True)
    return df


def split_df(df):
    srcs = df["source_filename"].unique().tolist()
    random.Random(SEED).shuffle(srcs)
    n = max(1, int(len(srcs) * TEST_SPLIT))
    train = df[df["source_filename"].isin(set(srcs[n:]))].reset_index(drop=True)
    test  = df[df["source_filename"].isin(set(srcs[:n]))].reset_index(drop=True)
    print(f"Train: {len(train)} seqs  |  Test: {len(test)} seqs")
    return train, test


def ref_cache_path(row):
    """Same key as Stage 1."""
    key = f"{os.path.basename(row['_root'])}_{row['sequence_id']}"
    return os.path.join(REF_DIR, f"{key}.npy")


def check_ref_cache(df):
    missing = [r["sequence_id"] for _, r in df.iterrows()
               if not os.path.isfile(ref_cache_path(r))]
    if missing:
        raise RuntimeError(
            f"{len(missing)} mean-frame cache files missing in {REF_DIR} "
            f"(e.g. {missing[:3]}). Run Stage 1 first so the cache is built.")
    print(f"[ref] All {len(df)} mean-frame references found.")

