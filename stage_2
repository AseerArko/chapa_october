# 4.  Dis-Net  (copied verbatim from Stage 1 so the checkpoint loads)
# ==============================================================================
class EncoderBlock(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, 3, padding=1), nn.BatchNorm2d(out_ch),
            nn.LeakyReLU(0.2, True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1), nn.BatchNorm2d(out_ch),
            nn.LeakyReLU(0.2, True),
        )
        self.pool = nn.MaxPool2d(2)

    def forward(self, x):
        feat = self.conv(x)
        return self.pool(feat), feat   # (pooled, skip)


class DecoderBlock(nn.Module):
    """Variational refinement: up + skip + intermediate warp -> refined warp."""
    def __init__(self, in_ch, skip_ch, out_ch):
        super().__init__()
        self.up   = nn.ConvTranspose2d(in_ch, out_ch, 4, stride=2, padding=1)
        self.warp_proj = nn.Conv2d(2, out_ch, 1)   # intermediate warp map -> feat
        self.conv = nn.Sequential(
            nn.Conv2d(out_ch + skip_ch + out_ch, out_ch, 3, padding=1),
            nn.BatchNorm2d(out_ch), nn.LeakyReLU(0.2, True),
        )
        self.warp_head = nn.Conv2d(out_ch, 2, 1)   # intermediate warp output

    def forward(self, x, skip, prev_warp_up):
        up   = self.up(x)
        pw   = F.interpolate(prev_warp_up, size=up.shape[-2:],
                             mode="bilinear", align_corners=True)
        pw_f = self.warp_proj(pw)
        cat  = torch.cat([up, skip, pw_f], dim=1)
        feat = self.conv(cat)
        warp = self.warp_head(feat)
        return feat, warp


class SingleFrameCNN(nn.Module):
    """Predicts a (2,H,W) warp map from [distorted frame | reference] (6 ch)."""
    def __init__(self, in_ch=6):
        super().__init__()
        self.e1 = EncoderBlock(in_ch, 32)
        self.e2 = EncoderBlock(32,  64)
        self.e3 = EncoderBlock(64, 128)
        self.e4 = EncoderBlock(128,256)

        self.bottleneck = nn.Sequential(
            nn.Conv2d(256, 256, 3, padding=1), nn.BatchNorm2d(256),
            nn.LeakyReLU(0.2, True),
        )
        self.warp_bottleneck = nn.Conv2d(256, 2, 1)

        self.d4 = DecoderBlock(256, 256, 128)
        self.d3 = DecoderBlock(128, 128,  64)
        self.d2 = DecoderBlock( 64,  64,  32)
        self.d1 = DecoderBlock( 32,  32,  16)

        self.final = nn.Conv2d(16, 2, 1)

    def forward(self, x):
        p1, s1 = self.e1(x)
        p2, s2 = self.e2(p1)
        p3, s3 = self.e3(p2)
        p4, s4 = self.e4(p3)

        b  = self.bottleneck(p4)
        w  = self.warp_bottleneck(b)

        f4, w4 = self.d4(b,  s4, w)
        f3, w3 = self.d3(f4, s3, w4)
        f2, w2 = self.d2(f3, s2, w3)
        f1, w1 = self.d1(f2, s1, w2)

        warp_final = self.final(f1) + F.interpolate(
            w1, size=f1.shape[-2:], mode="bilinear", align_corners=True)

        return warp_final, [w, w4, w3, w2]


class ConvLSTMCell(nn.Module):
    def __init__(self, in_ch, hidden_ch, ks=3):
        super().__init__()
        self.h = hidden_ch
        self.gates = nn.Conv2d(in_ch + hidden_ch, 4 * hidden_ch, ks,
                               padding=ks // 2)

    def forward(self, x, state):
        h, c = state
        i, f, o, g = torch.chunk(self.gates(torch.cat([x, h], 1)), 4, 1)
        c = torch.sigmoid(f) * c + torch.sigmoid(i) * torch.tanh(g)
        h = torch.sigmoid(o) * torch.tanh(c)
        return h, c

    def init(self, B, H, W, device, dtype):
        z = torch.zeros(B, self.h, H, W, device=device, dtype=dtype)
        return z.clone(), z.clone()


class DisNet(nn.Module):
    """
    Input:  frames (B,3,3,H,W) distorted frames,  ref (B,3,H,W) mean frame
    Output: warp   (B,2,H,W)   normalised warp field for middle frame
    """
    def __init__(self, lstm_hidden=64):
        super().__init__()
        self.branch = SingleFrameCNN(in_ch=6)
        self.lstm1 = ConvLSTMCell(2, lstm_hidden)
        self.lstm2 = ConvLSTMCell(lstm_hidden, lstm_hidden)
        self.refine = nn.Sequential(
            nn.Conv2d(lstm_hidden, 32, 3, padding=1), nn.LeakyReLU(0.2, True),
            nn.Conv2d(32, 2, 1),
        )

    def forward(self, frames, ref):
        B, T, C, H, W = frames.shape
        h1, c1 = self.lstm1.init(B, H, W, frames.device, frames.dtype)
        h2, c2 = self.lstm2.init(B, H, W, frames.device, frames.dtype)

        all_warps = []
        all_inter = []

        for t in range(T):
            x_t = torch.cat([frames[:, t], ref], dim=1)     # (B,6,H,W)
            warp_t, inter_t = self.branch(x_t)
            h1, c1 = self.lstm1(warp_t, (h1, c1))
            h2, c2 = self.lstm2(h1,     (h2, c2))
            refined = self.refine(h2) + warp_t
            all_warps.append(refined)
            all_inter.append(inter_t)

        return all_warps[1], all_warps, all_inter[1]


class WarpPredictor(nn.Module):
    """Frozen Dis-Net wrapper: middle-frame warp, clamped like Stage 1 training."""
    def __init__(self, disnet):
        super().__init__()
        self.net = disnet

    def forward(self, frames, ref):
        w, _, _ = self.net(frames, ref)
        return w.clamp(-WARP_CLAMP, WARP_CLAMP)

# ==============================================================================
# 5.  BACKWARD / FORWARD WARP UTILITIES
# ==============================================================================
def backward_warp(img, pred_w_norm, ws):
    """
    img:         (B, 3, H, W) distorted image
    pred_w_norm: (B, 2, H, W) normalised warp (Stage 1 output)
    Returns coarsely corrected image J_W.
    """
    B, C, H, W = img.shape
    wx_px = pred_w_norm[:, 0] * ws["wx_std"] + ws["wx_mean"]   # (B,H,W)
    wy_px = pred_w_norm[:, 1] * ws["wy_std"] + ws["wy_mean"]

    yy, xx = torch.meshgrid(torch.linspace(-1,1,H,device=img.device),
                            torch.linspace(-1,1,W,device=img.device),
                            indexing="ij")
    base = torch.stack([xx,yy],-1).unsqueeze(0)   # (1,H,W,2)
    dx   = 2.0 * wx_px / (W - 1)
    dy   = 2.0 * wy_px / (H - 1)
    grid = torch.stack([base[...,0] - dx,
                        base[...,1] - dy], -1)     # (B,H,W,2)
    return F.grid_sample(img, grid, mode="bilinear",
                         padding_mode="border", align_corners=True)


def forward_warp(img, pred_w_norm, ws):
    """Forward warp: re-apply distortion to generator output."""
    B, C, H, W = img.shape
    wx_px = pred_w_norm[:, 0] * ws["wx_std"] + ws["wx_mean"]
    wy_px = pred_w_norm[:, 1] * ws["wy_std"] + ws["wy_mean"]
    yy, xx = torch.meshgrid(torch.linspace(-1,1,H,device=img.device),
                            torch.linspace(-1,1,W,device=img.device),
                            indexing="ij")
    base = torch.stack([xx,yy],-1).unsqueeze(0)
    dx   = 2.0 * wx_px / (W - 1)
    dy   = 2.0 * wy_px / (H - 1)
    grid = torch.stack([base[...,0] + dx,
                        base[...,1] + dy], -1)
    return F.grid_sample(img, grid, mode="bilinear",
                         padding_mode="border", align_corners=True)

def build_g_input(I_mid, J_W, pred_w):
    """
    Warp-aware generator input (8 ch):
        I_mid   raw distorted middle frame           (3)
        J_W     coarse correction (I_mid unwarped)   (3)
        warp    Dis-Net warp, scaled to ~[-1, 1]     (2)
    The generator sees the distortion field next to the image it has to fix.
    """
    return torch.cat([I_mid, J_W, pred_w / WARP_CLAMP], 1)


# ==============================================================================
# 6.  GENERATOR — U-Net with 6 encoder / 6 decoder layers (Thapa et al. §3.2)
#
#   Encoder:  256 -> 128 -> 64 -> 32 -> 16 -> 8 -> 4
#   Decoder:  4 -> 8 -> 16 -> 32 -> 64 -> 128 -> 256
#   Channel bookkeeping (ngf=64), concat = decoder out + matching skip:
#     d6: in  8*ngf (e6)                 -> 8*ngf   (8x8)
#     d5: in  8+8 = 16*ngf (d6,e5)       -> 8*ngf   (16x16)
#     d4: in  8+8 = 16*ngf (d5,e4)       -> 8*ngf   (32x32)
#     d3: in  8+4 = 12*ngf (d4,e3)       -> 4*ngf   (64x64)
#     d2: in  4+2 =  6*ngf (d3,e2)       -> 2*ngf   (128x128)
#     d1: in  2+1 =  3*ngf (d2,e1)       -> 1*ngf   (256x256)
#     out: in ngf + in_ch (d1, input)    -> out_ch  (256x256, stride-1 conv)
# ==============================================================================
class UNetBlock(nn.Module):
    def __init__(self, in_ch, out_ch, down=True, bn=True, dropout=False):
        super().__init__()
        if down:
            self.conv = nn.Conv2d(in_ch, out_ch, 4, 2, 1, bias=not bn)
        else:
            self.conv = nn.ConvTranspose2d(in_ch, out_ch, 4, 2, 1, bias=not bn)
        self.bn      = nn.BatchNorm2d(out_ch) if bn else nn.Identity()
        self.act     = nn.LeakyReLU(0.2, True) if down else nn.ReLU(True)
        self.dropout = nn.Dropout(0.5) if dropout else nn.Identity()

    def forward(self, x):
        return self.dropout(self.bn(self.act(self.conv(x))))


class UNetGenerator(nn.Module):
    """
    Input:  [I_mid | J_W | warp]  (B, 8, 256, 256)  — see build_g_input
    Output: Ĵ   — refined clean image        (B, 3, 256, 256)
    """
    def __init__(self, in_ch=G_IN_CH, out_ch=3, ngf=64):
        super().__init__()
        # Encoder
        self.e1 = nn.Sequential(nn.Conv2d(in_ch, ngf, 4, 2, 1))   # no BN first
        self.e2 = UNetBlock(ngf,   ngf*2)
        self.e3 = UNetBlock(ngf*2, ngf*4)
        self.e4 = UNetBlock(ngf*4, ngf*8)
        self.e5 = UNetBlock(ngf*8, ngf*8)
        self.e6 = UNetBlock(ngf*8, ngf*8)

        # Decoder (input channels = previous decoder out + matching skip)
        self.d6 = UNetBlock(ngf*8,  ngf*8, down=False, dropout=True)
        self.d5 = UNetBlock(ngf*16, ngf*8, down=False, dropout=True)
        self.d4 = UNetBlock(ngf*16, ngf*8, down=False, dropout=True)
        self.d3 = UNetBlock(ngf*12, ngf*4, down=False)
        self.d2 = UNetBlock(ngf*6,  ngf*2, down=False)
        self.d1 = UNetBlock(ngf*3,  ngf,   down=False)

        # d1 is already at full resolution -> stride-1 output conv
        self.out = nn.Sequential(
            nn.Conv2d(ngf + in_ch, out_ch, 3, 1, 1),
            nn.Tanh()
        )

    def forward(self, x):
        e1 = self.e1(x)
        e2 = self.e2(e1); e3 = self.e3(e2)
        e4 = self.e4(e3); e5 = self.e5(e4); e6 = self.e6(e5)

        d6 = self.d6(e6)
        d5 = self.d5(torch.cat([d6, e5], 1))
        d4 = self.d4(torch.cat([d5, e4], 1))
        d3 = self.d3(torch.cat([d4, e3], 1))
        d2 = self.d2(torch.cat([d3, e2], 1))
        d1 = self.d1(torch.cat([d2, e1], 1))
        return self.out(torch.cat([d1, x], 1))   # d1 and x are both 256x256

# ==============================================================================
# 7.  DISCRIMINATOR — PatchGAN conditioned on J_W (the coarse correction)
#     Thapa et al. condition D on both J_W and the warp map W.
# ==============================================================================
class PatchDiscriminator(nn.Module):
    """
    Condition channels: J_W (3) + pred warp W (2) = 5
    Target channels:    Ĵ or J  (3)
    Total input:        8 channels
    """
    def __init__(self, cond_ch=5, target_ch=3, ndf=64):
        super().__init__()
        def blk(a, b, stride=2, bn=True):
            layers = [nn.utils.spectral_norm(
                          nn.Conv2d(a, b, 4, stride, 1, bias=not bn))]
            if bn: layers.append(nn.BatchNorm2d(b))
            layers.append(nn.LeakyReLU(0.2, True))
            return layers

        self.net = nn.Sequential(
            *blk(cond_ch + target_ch, ndf,  2, False),
            *blk(ndf,   ndf*2, 2),
            *blk(ndf*2, ndf*4, 2),
            *blk(ndf*4, ndf*8, 1),
            nn.utils.spectral_norm(nn.Conv2d(ndf*8, 1, 4, 1, 1)),
        )

    def forward(self, cond, target):
        return self.net(torch.cat([cond, target], 1))

# ==============================================================================
# 8.  HELPERS
# ==============================================================================
def _raw(m):
    return m.module if isinstance(m, nn.DataParallel) else m


def init_weights(m):
    if isinstance(m, (nn.Conv2d, nn.ConvTranspose2d)):
        nn.init.normal_(m.weight, 0.0, 0.02)
        if m.bias is not None: nn.init.zeros_(m.bias)
    elif isinstance(m, nn.BatchNorm2d):
        nn.init.normal_(m.weight, 1.0, 0.02); nn.init.zeros_(m.bias)


def append_csv(row, path):
    pd.DataFrame([row]).to_csv(path, mode="a",
                               header=not os.path.isfile(path), index=False)


def save_ckpt(epoch, G, D, opt_g, opt_d, sg, sd, history):
    state = {
        "epoch":     epoch,
        "G":         _raw(G).state_dict(),
        "D":         _raw(D).state_dict(),
        "opt_g":     opt_g.state_dict(),
        "opt_d":     opt_d.state_dict(),
        "scaler_g":  sg.state_dict(),
        "scaler_d":  sd.state_dict(),
        "torch_rng": torch.get_rng_state(),
        "cuda_rng":  (torch.cuda.get_rng_state_all()
                      if torch.cuda.is_available() else None),
        "np_rng":    np.random.get_state(),
        "py_rng":    random.getstate(),
        "history":   history,
    }
    tmp = RESUME_PATH + ".tmp"
    torch.save(state, tmp)
    os.replace(tmp, RESUME_PATH)


def load_ckpt(G, D, opt_g, opt_d, sg, sd):
    if not os.path.isfile(RESUME_PATH):
        return 0, []
    s = torch.load(RESUME_PATH, map_location=DEVICE, weights_only=False)
    _raw(G).load_state_dict(s["G"])
    _raw(D).load_state_dict(s["D"])
    opt_g.load_state_dict(s["opt_g"])
    opt_d.load_state_dict(s["opt_d"])
    try:
        sg.load_state_dict(s["scaler_g"]); sd.load_state_dict(s["scaler_d"])
    except Exception as e:
        print(f"[resume] Scaler state failed ({e}), fresh scalers.")
    try:
        torch.set_rng_state(s["torch_rng"].cpu())
        if torch.cuda.is_available() and s.get("cuda_rng"):
            torch.cuda.set_rng_state_all(s["cuda_rng"])
        np.random.set_state(s["np_rng"]); random.setstate(s["py_rng"])
    except Exception as e:
        print(f"[resume] RNG partial ({e}), continuing.")
    print(f"[resume] Loaded — {s['epoch']} epochs completed.")
    return s["epoch"], s.get("history", [])

# ==============================================================================
# 9.  SAMPLE VISUALISER
# ==============================================================================
def save_sample(G, dis_net, ds, epoch, ws):
    G.eval(); dis_net.eval()
    with torch.no_grad():
        frames, ref, gt, _ = ds[0]
        f_b = frames.unsqueeze(0).to(DEVICE)
        r_b = ref.unsqueeze(0).to(DEVICE)

        pred_w = dis_net(f_b, r_b)                          # (1,2,H,W)
        J_W    = backward_warp(f_b[:, 1], pred_w, ws)      # coarse correction
        J_hat  = G(build_g_input(f_b[:, 1], J_W, pred_w))   # refined output

    def to_rgb(t):
        return ((t[0].float().cpu().permute(1,2,0).numpy()+1)/2).clip(0,1)

    fig, ax = plt.subplots(1, 5, figsize=(20, 4))
    titles  = ["Distorted (mid frame)", "Coarse Correction (J_W)",
               "Generator Output (Ĵ)", "Ground Truth (J)",
               "Error |Ĵ - J|"]
    imgs    = [to_rgb(f_b[:,1]), to_rgb(J_W), to_rgb(J_hat),
               to_rgb(gt.unsqueeze(0)),
               np.abs(to_rgb(J_hat) - to_rgb(gt.unsqueeze(0))).mean(-1)]
    cmaps   = [None, None, None, None, "hot"]
    for a, title, img, cmap in zip(ax, titles, imgs, cmaps):
        a.imshow(img, cmap=cmap); a.set_title(title); a.axis("off")

    plt.suptitle(f"DG-GAN  Epoch {epoch:03d}", fontsize=13)
    plt.tight_layout()
    plt.savefig(os.path.join(SAMP_DIR, f"epoch_{epoch:03d}.png"), dpi=150)
    plt.close(fig)
    G.train()
    dis_net.eval()      # Dis-Net is frozen: never put it back in train mode

# ==============================================================================
# 10.  TRAINING
# ==============================================================================
def train():
    df = load_metadata()
    check_ref_cache(df)
    train_df, test_df = split_df(df)

    train_ds = WaveDataset(train_df)
    test_ds  = WaveDataset(test_df)

    loader_kw = dict(num_workers=NUM_WORKERS, pin_memory=True,
                     persistent_workers=(NUM_WORKERS > 0))
    if NUM_WORKERS > 0:
        loader_kw["prefetch_factor"] = 4
    train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True,
                              drop_last=True, **loader_kw)

    # ---- Load frozen Dis-Net (load BEFORE any DataParallel wrapping) ----
    disnet = DisNet().to(DEVICE)
    disnet.load_state_dict(
        torch.load(DISNET_CKPT, map_location=DEVICE, weights_only=True))
    dis_net = WarpPredictor(disnet).to(DEVICE)
    dis_net.eval()
    for p in dis_net.parameters():
        p.requires_grad_(False)
    print(f"[setup] Dis-Net loaded from {DISNET_CKPT} (frozen, clamp ±{WARP_CLAMP}).")

    if USE_MULTI_GPU:
        dis_net = nn.DataParallel(dis_net)

    # ---- G and D ----
    G = UNetGenerator().to(DEVICE)
    D = PatchDiscriminator(cond_ch=5, target_ch=3).to(DEVICE)
    G.apply(init_weights); D.apply(init_weights)

    if USE_MULTI_GPU:
        print(f"[setup] DataParallel across {NUM_GPUS} GPUs.")
        G = nn.DataParallel(G); D = nn.DataParallel(D)

    adv_loss = nn.BCEWithLogitsLoss()
    opt_g    = optim.Adam(G.parameters(), lr=LR_G, betas=(BETA1, 0.999))
    opt_d    = optim.Adam(D.parameters(), lr=LR_D, betas=(BETA1, 0.999))
    sg       = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    sd       = torch.amp.GradScaler("cuda", enabled=USE_AMP)

    done, history = load_ckpt(G, D, opt_g, opt_d, sg, sd)

    if done >= NUM_EPOCHS:
        print(f"[train] Already completed all {NUM_EPOCHS} epochs.")
        return G, dis_net, test_ds, True

    start = done + 1
    end   = min(done + EPOCHS_PER_RUN, NUM_EPOCHS)
    print(f"[train] This run: epochs {start}–{end} of {NUM_EPOCHS}.")

    for epoch in range(start, end + 1):
        # linear LR decay (set per epoch, so it is resume-safe)
        frac   = 1.0 if epoch < DECAY_START else \
                 max(0.0, (NUM_EPOCHS - epoch + 1) / (NUM_EPOCHS - DECAY_START + 1))
        lr_now = LR_G * frac
        for o, base in ((opt_g, LR_G), (opt_d, LR_D)):
            for g in o.param_groups:
                g['lr'] = base * frac
        G.train(); D.train(); dis_net.eval()
        totals = {k: torch.zeros((), device=DEVICE)
                  for k in ("g", "d", "l1", "l2", "dist")}
        t0 = time.perf_counter()
        t_prev = t0
        data_wait = 0.0          # time the GPU loop spent waiting for a batch

        for frames, ref, gt, _ in train_loader:
            data_wait += time.perf_counter() - t_prev
            frames = frames.to(DEVICE, non_blocking=True)   # (B,3,3,H,W)
            ref    = ref.to(DEVICE,    non_blocking=True)   # (B,3,H,W)
            gt     = gt.to(DEVICE,     non_blocking=True)   # (B,3,H,W)
            I_mid  = frames[:, 1]                           # distorted mid frame

            # ---- frozen Dis-Net (fp16, no grad) + coarse correction ----
            with torch.no_grad():
                with torch.amp.autocast("cuda", enabled=USE_AMP):
                    pred_w = dis_net(frames, ref)           # (B,2,H,W)
                pred_w = pred_w.float()
                J_W    = backward_warp(I_mid, pred_w, WARP_STATS)

            cond = torch.cat([J_W, pred_w], 1)              # D condition (5 ch)
            g_in = build_g_input(I_mid, J_W, pred_w)        # G input     (8 ch)

            # ---- one generator forward, shared by the D and G steps ----
            with torch.amp.autocast("cuda", enabled=USE_AMP):
                J_hat = G(g_in)

            # ---- Discriminator step ----
            opt_d.zero_grad(set_to_none=True)
            with torch.amp.autocast("cuda", enabled=USE_AMP):
                real_out = D(cond, gt)
                fake_out = D(cond, J_hat.detach())
                loss_d   = 0.5 * (
                    adv_loss(real_out, torch.ones_like(real_out)  * 0.9) +
                    adv_loss(fake_out, torch.zeros_like(fake_out))
                )
            sd.scale(loss_d).backward()
            sd.step(opt_d); sd.update()

            # ---- Generator step (D params frozen: no wasted D gradients) ----
            for q in D.parameters():
                q.requires_grad_(False)
            opt_g.zero_grad(set_to_none=True)
            with torch.amp.autocast("cuda", enabled=USE_AMP):
                fake_out = D(cond, J_hat)
                loss_adv = adv_loss(fake_out, torch.ones_like(fake_out))

                Jf       = J_hat.float()
                loss_l1  = F.l1_loss(Jf, gt)
                loss_l2  = F.mse_loss(Jf, gt)

                # distortion cycle: forward-warp J_hat -> compare to I_mid
                I_hat_G   = forward_warp(Jf, pred_w, WARP_STATS)
                loss_dist = F.mse_loss(I_hat_G, I_mid)

                loss_g = (LAMBDA_GAN  * loss_adv  +
                          LAMBDA_L1   * loss_l1   +
                          LAMBDA_L2   * loss_l2   +
                          LAMBDA_DIST * loss_dist)

            sg.scale(loss_g).backward()
            sg.unscale_(opt_g)                       # unscale BEFORE clipping
            nn.utils.clip_grad_norm_(G.parameters(), 1.0)
            sg.step(opt_g); sg.update()
            for q in D.parameters():
                q.requires_grad_(True)

            totals["g"]    += loss_g.detach()
            totals["d"]    += loss_d.detach()
            totals["l1"]   += loss_l1.detach()
            totals["l2"]   += loss_l2.detach()
            totals["dist"] += loss_dist.detach()
            t_prev = time.perf_counter()

        n    = len(train_loader)
        avgs = {k: float(v) / n for k, v in totals.items()}
        elapsed = time.perf_counter() - t0

        print(f"Epoch {epoch:03d}/{NUM_EPOCHS} | "
              f"G={avgs['g']:.4f} | D={avgs['d']:.4f} | "
              f"L1={avgs['l1']:.4f} | L2={avgs['l2']:.4f} | "
              f"Dist={avgs['dist']:.4f} | {elapsed:.1f}s "
              f"(data wait {data_wait:.1f}s) lr={lr_now:.2e}")

        row = {"epoch": epoch, **{f"avg_{k}": v for k, v in avgs.items()},
               "time_s": elapsed, "data_wait_s": data_wait,
               "timestamp": time.strftime("%Y-%m-%d %H:%M:%S")}
        append_csv(row, LOG_CSV)
        history.append(row)

        save_ckpt(epoch, G, D, opt_g, opt_d, sg, sd, history)

        if epoch % 25 == 0 or epoch == NUM_EPOCHS:
            torch.save(_raw(G).state_dict(),
                       os.path.join(CKPT_DIR, f"generator_epoch{epoch:03d}.pth"))
            save_sample(G, dis_net, train_ds, epoch, WARP_STATS)

    complete = (end == NUM_EPOCHS)
    if complete:
        torch.save(_raw(G).state_dict(),
                   os.path.join(CKPT_DIR, "generator_final.pth"))
        print(f"\n[train] DG-GAN complete ({NUM_EPOCHS} epochs).")
    else:
        print(f"\n[train] Stopped after epoch {end}/{NUM_EPOCHS}. "
              f"Re-run to continue.")

    return G, dis_net, test_ds, complete

# ==============================================================================
# 11.  EVALUATION
# ==============================================================================
def evaluate(G, dis_net, test_ds):
    G.eval(); dis_net.eval()
    loader = DataLoader(test_ds, batch_size=1, shuffle=False,
                        num_workers=NUM_WORKERS)
    ssims, psnrs, mses = [], [], []

    with torch.no_grad():
        for frames, ref, gt, names in loader:
            frames = frames.to(DEVICE); ref = ref.to(DEVICE); gt = gt.to(DEVICE)
            pred_w = dis_net(frames, ref)
            J_W    = backward_warp(frames[:, 1], pred_w, WARP_STATS)
            J_hat  = G(build_g_input(frames[:, 1], J_W, pred_w))

            r = ((J_hat[0].float().cpu().numpy().transpose(1,2,0)+1)/2).clip(0,1)
            g = ((gt[0].float().cpu().numpy().transpose(1,2,0)+1)/2).clip(0,1)
            ssims.append(ssim_fn(g, r, channel_axis=2, data_range=1))
            psnrs.append(psnr_fn(g, r, data_range=1))
            mses.append(float(np.mean((r - g)**2)))

    print("\n" + "="*50)
    print("DG-GAN  TEST RESULTS")
    print("="*50)
    print(f"SSIM:  {np.mean(ssims):.4f}")
    print(f"PSNR:  {np.mean(psnrs):.2f} dB")
    print(f"MSE:   {np.mean(mses):.6f}")

    results = {"ssim": float(np.mean(ssims)),
               "psnr": float(np.mean(psnrs)),
               "mse":  float(np.mean(mses)),
               "n":    len(ssims),
               "timestamp": time.strftime("%Y-%m-%d %H:%M:%S")}
    with open(EVAL_JSON, "w") as f:
        json.dump(results, f, indent=2)
    print(f"Saved: {EVAL_JSON}")
    return results

# ==============================================================================
# 12.  ENTRY POINT
# ==============================================================================
G, dis_net, test_ds, complete = train()

if not complete:
    print(f"\nRe-run this script to continue the next "
          f"{EPOCHS_PER_RUN} epochs.")
else:
    print("\nRunning evaluation on test set...")
    evaluate(G, dis_net, test_ds)
